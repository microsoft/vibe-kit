# Backend .dockerignore
# Exclude files not needed in the Docker build

# Python virtual environments (dependencies installed fresh in container)
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Environment files with secrets
.env
.env.local
.env.*

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Documentation
*.md
!README.md

# OS files
.DS_Store
Thumbs.db

# Job data (should be mounted as volume in production)
data/jobs/

# Ruff cache
.ruff_cache/

# MyPy cache
.mypy_cache/
