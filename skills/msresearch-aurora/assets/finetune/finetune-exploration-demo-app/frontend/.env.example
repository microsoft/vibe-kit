# Set to "true" when deploying with external network access (e.g., Google Fonts CDN).
# When "false" or unset, fonts fall back to system defaults.
VITE_EXTERNAL=false

# URL for the Microsoft AI for Science homepage link in the header banner.
VITE_AI4S_HOME_URL=https://www.microsoft.com/en-us/research/lab/microsoft-research-ai-for-science/
