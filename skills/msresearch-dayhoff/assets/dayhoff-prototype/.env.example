# Dayhoff Prototype - Environment Variables
# Copy this file to .env and fill in your values

# Azure ML Scoring Endpoint (required for hosted mode)
DAYHOFF_ENDPOINT=https://your-endpoint.<your-region>.inference.ml.azure.com/score
DAYHOFF_API_KEY=your_api_key_here

# ESMFold Structure Prediction (optional)
# Defaults to public ESM Atlas API (https://api.esmatlas.com/foldSequence/v1/pdb/)
# which has a hard 400 aa limit. Point at a self-hosted endpoint to lift the cap.
ESMFOLD_ENDPOINT=https://your-fold-endpoint.<your-region>.inference.ml.azure.com/score
ESMFOLD_API_KEY=your_fold_api_key_here
ESMFOLD_MAX_LENGTH=1200

# Flask Configuration
FLASK_PORT=5001
FLASK_DEBUG=0
